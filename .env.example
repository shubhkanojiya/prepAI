# ---------------------------------------------------------------------------
# PrepAI environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_URL=http://localhost:8000

# --- Database --------------------------------------------------------------
# PostgreSQL (required):
DATABASE_URL=postgres://prepai:prepai@localhost:5432/prepai
DB_CONN_MAX_AGE=600

# --- Cache (optional) -------------------------------------------------------
# Requires `pip install redis`. Empty = in-process memory cache.
REDIS_URL=

# --- AI provider -------------------------------------------------------------
# AI_PROVIDER: anthropic | xai | groq | openrouter | openai_compatible | mock | disabled
#   groq / openrouter: base URL and default models are filled in automatically.
#   openai_compatible: any other OpenAI-style API — also set AI_BASE_URL.
AI_PROVIDER=anthropic
AI_API_KEY=
# Empty = provider default (anthropic: claude-opus-5; groq/openrouter: a Llama model).
AI_MODEL=
# OpenAI-compatible providers only: model for image requests (the scanner) and API base URL.
AI_VISION_MODEL=
AI_BASE_URL=
# Seconds to wait for a single AI response before failing gracefully.
AI_TIMEOUT=90
AI_MAX_TOKENS=8000
# Optional effort level: low | medium | high | xhigh | max (empty = provider default)
AI_EFFORT=
# Re-run a declined request on a fallback model server-side (Anthropic only).
AI_REFUSAL_FALLBACK=True

# OCR_BACKEND: vision_llm (use the AI model's vision) | tesseract | none
OCR_BACKEND=vision_llm

# --- Rate limits (Django REST Framework throttle syntax) --------------------
THROTTLE_ANON=200/hour
THROTTLE_USER=2000/hour
THROTTLE_AI_ASSISTANT=60/hour
THROTTLE_AI_SCANNER=30/hour
# Guests (not logged in) may scan too, but get a small per-IP budget since each scan is a paid AI call.
THROTTLE_AI_SCANNER_GUEST=5/day
# Reverse proxies in front of the app (Render/Railway/Vercel/nginx = 1). Used to find the real client
# IP for rate limits. Defaults to 0 when DEBUG=True and 1 otherwise.
# NUM_PROXIES=1

# --- Uploads -------------------------------------------------------------------
MAX_PDF_UPLOAD_MB=25
MAX_IMAGE_UPLOAD_MB=8

# --- Media storage -------------------------------------------------------------
# STORAGE_BACKEND: local | s3  (s3 requires `pip install django-storages[s3]`)
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_CUSTOM_DOMAIN=
# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com and AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=

# --- Email -------------------------------------------------------------------
# Console backend prints emails (e.g. password reset) to the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PrepAI <no-reply@prepai.local>

# --- Security (production) --------------------------------------------------
# When DEBUG=False these default to: redirect HTTP→HTTPS and 1-year HSTS.
# Only uncomment to override (e.g. SSL terminated elsewhere without forwarding headers).
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# --- Optional Google sign-in (see README "Google authentication") ------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
